# Doxygen configuration. Build with `cmake --build build --target docs`
# or, from the repository root, `doxygen docs/Doxyfile`.
PROJECT_NAME           = "Gravitational Molecule"
PROJECT_BRIEF          = "Boson clouds in binary black holes with a mode-decomposed Crank-Nicolson solver"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
INPUT                  = README.md include src
FILE_PATTERNS          = *.hpp *.cpp *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
SOURCE_BROWSER         = YES
STRIP_FROM_PATH        = .
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
USE_MATHJAX            = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO
HAVE_DOT               = NO
